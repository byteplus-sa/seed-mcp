{
  "ark_list_models": {
    "input": {}
  },
  "media_prepare_upload": {
    "input": {
      "media_type": "image",
      "mime_type": "image/png",
      "size_bytes": 1048576
    }
  },
  "seedream_generate_image": {
    "input": {
      "model": "dola-seedream-5-5-261028",
      "prompt": "Embroidered heart and daisy patches, transparent background.",
      "size": "2K",
      "response_format": "url",
      "output_format": "png",
      "background": "transparent",
      "watermark": true,
      "dry_run": true
    }
  },
  "seedance_create_task": {
    "input": {
      "prompt": "A paper boat floats on calm water.",
      "resolution": "4k",
      "dry_run": true
    }
  },
  "omnihuman_create_task": {
    "input": {
      "image": "https://example.com/portrait.png",
      "audio": "https://example.com/speech.mp3"
    }
  },
  "seed_audio_generate": {
    "input": {
      "text_prompt": "Gentle rain on a window. Max duration: 5 seconds"
    }
  },
  "gen_task_get": {
    "input": {
      "task_ids": ["cgt-example-replace-me"],
      "persist_output": false
    }
  }
}
