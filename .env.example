# ============================================================================
# Ark Seed Multimodal MCP Server — environment template
#
# Local stdio template. Provider credentials below are local-only.
# For hosted HTTP use deploy/helm/seed-mcp and docs/byteplus-terraform.md; provider keys and
# X-MCP-Client-Secret arrive only in caller headers, never hosted environment.
#
# See specs/SPEC_HOSTED_BYOK.md.
# ============================================================================

# --- Local stdio provider credentials -------------------------------------
# ModelArk data-plane key for Seedream and Seedance.
# Region-scoped: must match BYTEPLUS_MODELARK_BASE_URL.
BYTEPLUS_MODELARK_API_KEY=

# Seed Speech key for Seed Audio (full-scene audio generation).
# Distinct from ModelArk; uses X-Api-Key, not Bearer.
BYTEPLUS_SEED_SPEECH_API_KEY=

# --- Provider base URLs ----------------------------------------------------
# ModelArk data-plane host. Default: ap-southeast region.
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Seed Speech host. Default: ap-southeast-1 region.
BYTEPLUS_SEED_AUDIO_BASE_URL=https://voice.ap-southeast-1.bytepluses.com

# --- Model bindings --------------------------------------------------------
# Bind logical families to account-authorized model/endpoint IDs.
# These are configuration, not hard-coded truth.
# The account must be authorized for Seedream 5.5.
# Keep dola-seedream-5-0-pro-260628 here to retain the previous default.
SEEDREAM_DEFAULT_MODEL=dola-seedream-5-5-261028
SEEDANCE_DEFAULT_MODEL=dreamina-seedance-2-5-260628
# Prompt optimization mode Seedream 5.0 Pro uses when a caller omits
# prompt_optimization: 'standard' favors prompt-following quality, 'fast'
# favors latency. Both are accepted by the provider; an explicit per-call
# value always wins.
SEEDREAM_PROMPT_OPTIMIZATION_MODE=standard
# The built-in default IDs have known families. Any custom default ID must set
# a family or provide the JSON binding list below; names are never inferred.
# seedream: seedream_5_5 | pro | lite | 4x
# seedance: standard | fast | mini | seedance_2_5 | seedance_2_5_flash
SEEDREAM_MODEL_FAMILY=
SEEDANCE_MODEL_FAMILY=
# JSON arrays for multiple explicitly authorized models, for example:
# SEEDREAM_MODEL_BINDINGS=[{"model_id":"my-image-endpoint","family":"pro"}]
# To select both Seedream 5.5 and 5.0 Pro, bind both:
# SEEDREAM_MODEL_BINDINGS=[{"model_id":"dola-seedream-5-5-261028","family":"seedream_5_5"},{"model_id":"dola-seedream-5-0-pro-260628","family":"pro"}]
# SEEDANCE_MODEL_BINDINGS=[{"model_id":"my-video-endpoint","family":"standard"}]
# Empty bindings add Flash alongside the selected default (regular 2.5 unless overridden).
# Explicit lists are authoritative. To also call Seedance 2.0, bind all three:
# SEEDANCE_MODEL_BINDINGS=[{"model_id":"dreamina-seedance-2-5-260628","family":"seedance_2_5"},{"model_id":"dreamina-seedance-2-5-flash-261115","family":"seedance_2_5_flash"},{"model_id":"dreamina-seedance-2-0-260128","family":"standard"}]
SEEDREAM_MODEL_BINDINGS=
SEEDANCE_MODEL_BINDINGS=

# --- OmniHuman 2.0 (BytePlus Vision AI) -------------------------------------
# Feature flag. Disabled by default: no omnihuman_* tools are registered unless
# this is true. Local stdio also requires BYTEPLUS_CV_API_KEY; HTTP requires
# the caller's X-OmniHuman-Api-Key. The Vision AI key is separate from ModelArk.
BYTEPLUS_OMNIHUMAN_ENABLED=false
BYTEPLUS_CV_API_KEY=
# BYTEPLUS_CV_BASE_URL=https://openapi.cv.bytepluses.com

# --- MCP transport ---------------------------------------------------------
# stdio (default, local) or http (Streamable HTTP, remote deployment).
MCP_TRANSPORT=stdio
# Bind address for HTTP transport. 127.0.0.1 by default to prevent DNS rebinding.
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Optional HTTP-runtime metrics listener; 0 disables, otherwise 1024-65535.
# Binds only 127.0.0.1, never expose through a Service or public proxy.
MCP_METRICS_PORT=0
# Comma-separated allowed Origin values for HTTP transport. Empty = localhost only.
MCP_ALLOWED_ORIGINS=
# Comma-separated Host header values. Include the public hostname for remote use.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Local readiness option; HTTP never checks provider connectivity.
READINESS_CHECK_PROVIDERS=false
# Per-provider timeout for readiness checks. Default: 2.0 seconds.
READINESS_PROVIDER_TIMEOUT_SECONDS=2.0
# Maximum HTTP requests per minute per client IP. HTTP requires a positive value.
RATE_LIMIT_RPM=60
# Maximum burst size for the token bucket. 0 defaults to RATE_LIMIT_RPM.
RATE_LIMIT_BURST=0
# Comma-separated canonical trusted proxy CIDRs; empty trusts no forwarded headers.
# Replaces the removed boolean setting. Catch-all networks are rejected.
# VKE's same-pod Caddy uses 127.0.0.1/32 and overwrites forwarded addresses.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# local is stdio-only. All HTTP, including loopback, requires byok.
MCP_AUTH_MODE=local
# Required for HTTP: operator-owned random 32-byte secret, 64 lowercase hex.
# Keep stable across restarts; changes create new ownership scopes, no recovery bridge.
MCP_IDENTITY_HMAC_KEY=
MCP_IDENTITY_KEY_VERSION=1

# --- TOS object storage (local stdio only, optional) ------------------------
# Enables the `media_upload` and `media_presign` tools, which upload media to
# a private TOS bucket and return presigned HTTPS GET URLs. Required for Seedance video
# references, which accept a URL only (no inline Base64).
# AK and SK must both be set or both be empty. Keep the bucket private;
# presigned URLs grant temporary read access to individual objects.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# Optional temporary security token (STS credentials only).
TOS_SECURITY_TOKEN=
# Target bucket name. The tool registers only when AK + SK + bucket are set.
TOS_BUCKET=
# Region and endpoint must match where the bucket was created.
# Endpoint format: tos-<region>.bytepluses.com
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
# Presigned URL validity in seconds. Range: 60–604800. Default: 30 minutes.
TOS_PRESIGN_TTL_SECONDS=1800

# --- S3 object storage (local stdio only, optional) -------------------------
# Alternative to TOS. Set OBJECT_STORAGE_BACKEND=s3 to use S3 instead of TOS
# for the `media_upload` and `media_presign` tools. Supports native AWS S3 and S3-compatible
# storage (MinIO, R2, TOS-via-boto3) via S3_ENDPOINT.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Target bucket name. The tool registers only when AK + SK + bucket are set.
S3_BUCKET=
# AWS region. Default: us-east-1.
S3_REGION=us-east-1
# Empty = native AWS endpoint resolved from region. Set for S3-compatible
# storage (e.g. "https://tos-<region>.bytepluses.com", MinIO endpoint).
S3_ENDPOINT=
# Presigned URL validity in seconds. Range: 60–604800. Default: 30 minutes.
S3_PRESIGN_TTL_SECONDS=1800
# Select the active object-storage backend: tos (default) or s3.
OBJECT_STORAGE_BACKEND=tos
# Maximum total decoded bytes in one media_upload call. Default: 500 MiB.
MEDIA_UPLOAD_BATCH_MAX_BYTES=524288000

# --- Artifact persistence --------------------------------------------------
# filesystem stores artifacts on local disk; object_storage stores them in
# the configured TOS/S3 bucket (requires TOS_* or S3_* credentials).
ARTIFACT_BACKEND=filesystem
ARTIFACT_DIR=.artifacts
# Task ownership/budget/cache state backend. Only sqlite (single instance).
# HTTP BYOK requires fresh state; no old-schema migration.
STATE_BACKEND=sqlite
STATE_MAX_RECORDS=100000
# Interval in seconds between background artifact/state expiry sweeps.
ARTIFACT_SWEEP_INTERVAL_SECONDS=3600
# Max age in days for ownership/budget/cache rows before pruning.
STATE_PRUNE_MAX_AGE_DAYS=30
# Artifact retention TTL in seconds. Default: 7 days (604800).
ARTIFACT_TTL_SECONDS=604800
# Inline media cap for MCP image/audio content blocks. Default: 8 MiB.
MCP_INLINE_MEDIA_MAX_BYTES=8388608
# HTTP is URL-only with bounded admission; both limits must be positive.
MCP_HTTP_MAX_BODY_BYTES=2097152
MCP_HTTP_MAX_IN_FLIGHT=64
# Timeout in seconds for each attempt to download provider output into
# artifact storage (both backends). Default: 120.
ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS=120
# Attempts (1-10) for a retryable output download (timeouts, network errors,
# 408/429/5xx), with 1s, 2s, 4s backoff. Default: 3.
ARTIFACT_DOWNLOAD_MAX_ATTEMPTS=3
# When inline Base64 output (Seed Audio, Seedream b64_json) cannot be stored,
# return it inline up to this decoded size instead of dropping it. 0 disables.
# Default: 8 MiB.
ARTIFACT_INLINE_FALLBACK_MAX_BYTES=8388608

# --- Local output paths (stdio only) ---------------------------------------
# Comma-separated absolute directories where tools may write files
# (output_path, output_dir, destination_path). The client's MCP roots
# take precedence when available; with neither, path writing is disabled.
# OUTPUT_ROOTS=/Users/me/projects,/Users/me/Downloads

# --- HTTP timeouts (milliseconds) ------------------------------------------
BYTEPLUS_CONNECT_TIMEOUT_MS=10000
# 10-minute request timeout covers long synchronous Seedream Pro generations
# (60–150s typical, longer under cold start or provider queue).
BYTEPLUS_REQUEST_TIMEOUT_MS=600000
# --- Runtime policy --------------------------------------------------------
# Both transports execute directly; no MCP jobs or native task extension.
# Finite positive seconds, max 30: total wait for owner then provider slots.
MCP_ADMISSION_TIMEOUT_SECONDS=2.0
# Finite positive seconds, max 3600: cooperative whole-tool deadline.
# SDK/SQLite draining may exceed it. Use client timeout 660s with this default.
# Keep accepted task IDs; a timeout does not cancel provider work. Never blindly resubmit.
# HTTP shutdown: max(tool timeout, provider timeout in seconds) + 30.
# VKE pod termination grace uses the same max + 60.
MCP_TOOL_TIMEOUT_SECONDS=600.0
PROVIDER_MAX_CONCURRENCY=5
PRINCIPAL_MAX_CONCURRENCY=3
# Per-principal UTC daily estimate limit in USD. 0 records without blocking.
DAILY_BUDGET_USD=0
# Maximum number of provider task IDs cached in the artifact-resolution cache.
PERSISTENCE_CACHE_MAX_SIZE=10000
# TTL in seconds for cached task-to-artifact mappings. Default: 24 hours.
PERSISTENCE_CACHE_TTL_SECONDS=86400

# --- Logging ---------------------------------------------------------------
# Minimum log level for structured stderr logs: DEBUG | INFO | WARNING | ERROR
ARK_LOG_LEVEL=INFO
