{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["prerequisitesConfirmed", "image", "imagePullSecrets", "publicHost", "identitySecret", "tlsSecretName", "service", "storage", "app", "models", "resources"],
  "properties": {
    "prerequisitesConfirmed": {
      "const": true,
      "description": "Manual acknowledgement of private cluster access, compatible Running csi-ebs and CCM addons, CSI rollouts, Ready nodes with capacity, existing identity/TLS Secrets and DNS/TLS checks. Not programmatic proof."
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$",
      "description": "Operator-built BYOK application image pinned by immutable digest."
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/name"}
    },
    "publicHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "identitySecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hmacKey", "versionKey"],
      "properties": {
        "name": {"$ref": "#/definitions/name"},
        "hmacKey": {"const": "MCP_IDENTITY_HMAC_KEY"},
        "versionKey": {"const": "MCP_IDENTITY_KEY_VERSION"}
      }
    },
    "tlsSecretName": {"$ref": "#/definitions/name"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subnetId", "bandwidthMbps", "sourceRanges"],
      "properties": {
        "subnetId": {"type": "string", "pattern": "^subnet-[a-z0-9]+$"},
        "bandwidthMbps": {"type": "integer", "minimum": 1, "maximum": 200},
        "sourceRanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "project", "sizeGiB", "encrypted", "kmsPrerequisitesConfirmed"],
      "properties": {
        "zone": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "project": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "sizeGiB": {"type": "integer", "minimum": 20, "maximum": 2048},
        "encrypted": {"type": "boolean"},
        "kmsPrerequisitesConfirmed": {"type": "boolean"}
      },
      "if": {"properties": {"encrypted": {"const": true}}},
      "then": {"properties": {"kmsPrerequisitesConfirmed": {"const": true}}}
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolTimeoutSeconds", "providerTimeoutSeconds", "admissionTimeoutSeconds", "maxBodyBytes", "maxInFlight", "rateLimitRpm", "rateLimitBurst", "dailyBudgetUsd", "providerMaxConcurrency", "principalMaxConcurrency", "stateMaxRecords", "metricsEnabled", "omnihumanEnabled"],
      "properties": {
        "toolTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "providerTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "admissionTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "maxBodyBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "maxInFlight": {"type": "integer", "minimum": 1, "maximum": 256},
        "rateLimitRpm": {"type": "integer", "minimum": 1, "maximum": 10000},
        "rateLimitBurst": {"type": "integer", "minimum": 0, "maximum": 10000},
        "dailyBudgetUsd": {"type": "number", "minimum": 0, "maximum": 1000000},
        "providerMaxConcurrency": {"type": "integer", "minimum": 1, "maximum": 256},
        "principalMaxConcurrency": {"type": "integer", "minimum": 1, "maximum": 256},
        "stateMaxRecords": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "metricsEnabled": {"type": "boolean"},
        "omnihumanEnabled": {"type": "boolean"}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedream", "seedance"],
      "description": "Operator-verified exact bindings, visible in anonymous discovery. Never provider credentials or self-declared client authority.",
      "properties": {
        "seedream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultModel", "bindings"],
          "properties": {
            "defaultModel": {"$ref": "#/definitions/modelId"},
            "bindings": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["model_id", "family"],
                "properties": {
                  "model_id": {"$ref": "#/definitions/modelId"},
                  "family": {"enum": ["seedream_5_5", "pro", "lite", "4x"]}
                }
              }
            }
          }
        },
        "seedance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultModel", "bindings"],
          "properties": {
            "defaultModel": {"$ref": "#/definitions/modelId"},
            "bindings": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["model_id", "family"],
                "properties": {
                  "model_id": {"$ref": "#/definitions/modelId"},
                  "family": {"enum": ["standard", "fast", "mini", "seedance_2_5", "seedance_2_5_flash"]}
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "proxy"],
      "properties": {
        "app": {"$ref": "#/definitions/resources"},
        "proxy": {"$ref": "#/definitions/resources"}
      }
    }
  },
  "definitions": {
    "modelId": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$", "not": {"pattern": "[^A-Za-z0-9._-]"}},
    "name": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuRequestMillis", "cpuLimitMillis", "memoryRequestMiB", "memoryLimitMiB"],
      "properties": {
        "cpuRequestMillis": {"type": "integer", "minimum": 50, "maximum": 4000},
        "cpuLimitMillis": {"type": "integer", "minimum": 50, "maximum": 4000},
        "memoryRequestMiB": {"type": "integer", "minimum": 32, "maximum": 8192},
        "memoryLimitMiB": {"type": "integer", "minimum": 32, "maximum": 8192}
      }
    }
  }
}
