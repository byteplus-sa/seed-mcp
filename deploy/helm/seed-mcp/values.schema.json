{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prerequisitesConfirmed",
    "replicaCount",
    "autoscaling",
    "image",
    "imagePullSecrets",
    "publicHost",
    "backendHost",
    "identitySecret",
    "tlsSecretName",
    "temporaryUpload",
    "service",
    "app",
    "models",
    "resources"
  ],
  "properties": {
    "prerequisitesConfirmed": {
      "const": true,
      "description": "Operator acknowledgement: private cluster access, maintained VKE >=1.30, CCM, two Ready nodes with surge capacity, identity/TLS Secrets, DNS/TLS and metrics API if HPA enabled. No database or state migration is performed."
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6,
      "description": "Fixed pod count when HPA is disabled; ignored by the Deployment with HPA enabled."
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "scaleDownStabilizationSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 3600
        }
      },
      "description": "CPU HPA requires verified metrics API; fixed steps are up to two pods up/one down per 60 seconds. Default max six is a starting bound, not connection or throughput certification."
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$",
      "description": "Operator-built BYOK application image pinned by immutable digest."
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "publicHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "backendHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Distinct private TLS/SNI hostname for either APIG mode; empty for public-clb."
    },
    "identitySecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hmacKey",
        "versionKey"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "hmacKey": {
          "const": "MCP_IDENTITY_HMAC_KEY"
        },
        "versionKey": {
          "const": "MCP_IDENTITY_KEY_VERSION"
        }
      }
    },
    "tlsSecretName": {
      "$ref": "#/definitions/name"
    },
    "temporaryUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingSecret", "credentialsMode", "irsa"],
      "description": "Opt-in prepare-only TOS signing; static Secret or explicit IRSA, never a metadata credential chain. Bucket/IAM/CORS/expiry and IRSA remain operator gates.",
      "properties": {
        "enabled": {"type": "boolean"},
        "credentialsMode": {"enum": ["static", "irsa"]},
        "irsa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prerequisitesConfirmed", "serviceAccountName", "roleTrn", "stsEndpoint", "durationSeconds"],
          "properties": {
            "prerequisitesConfirmed": {"type": "boolean"},
            "serviceAccountName": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "roleTrn": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^$|^trn:iam::[0-9]+:role/[A-Za-z0-9+=,.@_-]{1,128}$"
            },
            "stsEndpoint": {
              "enum": ["https://sts.byteplusapi.com", "https://open.byteplusapi.com"]
            },
            "durationSeconds": {"type": "integer", "minimum": 3600, "maximum": 43200}
          }
        },
        "existingSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"existingSecret": {"$ref": "#/definitions/name"}}},
      "allOf": [{
        "if": {"properties": {"credentialsMode": {"const": "irsa"}}},
        "then": {
          "properties": {
            "enabled": {"const": true},
            "irsa": {
              "properties": {
                "prerequisitesConfirmed": {"const": true},
                "serviceAccountName": {"$ref": "#/definitions/name"},
                "roleTrn": {"minLength": 1}
              }
            }
          }
        }
      }]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "productionConfirmed",
        "subnetId",
        "bandwidthMbps",
        "sourceRanges"
      ],
      "properties": {
        "mode": {
          "enum": ["public-clb", "apig-staging", "apig-production"]
        },
        "productionConfirmed": {
          "type": "boolean",
          "description": "Production-only operator acknowledgement of the documented backend trust decision (verified APIG chain/SAN/expiry or an explicit deployment-scoped risk acceptance), logging/routing, credential recovery, certificate lifecycle and launch approval. HTTPS remains required. This flag performs no verification and grants no exception by itself."
        },
        "subnetId": {
          "type": "string",
          "pattern": "^$|^subnet-[a-z0-9]+$"
        },
        "bandwidthMbps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "sourceRanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolTimeoutSeconds",
        "providerTimeoutSeconds",
        "admissionTimeoutSeconds",
        "maxBodyBytes",
        "maxInFlight",
        "rateLimitRpm",
        "rateLimitBurst",
        "dailyBudgetUsd",
        "providerMaxConcurrency",
        "principalMaxConcurrency",
        "metricsEnabled"
      ],
      "properties": {
        "toolTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "providerTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "admissionTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "rateLimitRpm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "rateLimitBurst": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "dailyBudgetUsd": {
          "const": 0,
          "description": "Stateless HTTP has no budget ledger; use provider spend controls."
        },
        "providerMaxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "principalMaxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "metricsEnabled": {
          "type": "boolean"
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seedream",
        "seedance"
      ],
      "description": "Operator-verified exact bindings, visible in anonymous discovery. Never provider credentials or self-declared client authority.",
      "properties": {
        "seedream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultModel",
            "bindings"
          ],
          "properties": {
            "defaultModel": {
              "$ref": "#/definitions/modelId"
            },
            "bindings": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model_id",
                  "family"
                ],
                "properties": {
                  "model_id": {
                    "$ref": "#/definitions/modelId"
                  },
                  "family": {
                    "enum": [
                      "seedream_5_5"
                    ]
                  }
                }
              }
            }
          }
        },
        "seedance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultModel",
            "bindings"
          ],
          "properties": {
            "defaultModel": {
              "$ref": "#/definitions/modelId"
            },
            "bindings": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model_id",
                  "family"
                ],
                "properties": {
                  "model_id": {
                    "$ref": "#/definitions/modelId"
                  },
                  "family": {
                    "enum": [
                      "standard",
                      "fast",
                      "mini",
                      "seedance_2_5",
                      "seedance_2_5_flash"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "proxy"
      ],
      "properties": {
        "app": {
          "$ref": "#/definitions/resources"
        },
        "proxy": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  },
  "allOf": [{
    "if": {
      "properties": {"service": {"properties": {"mode": {"enum": ["apig-staging", "apig-production"]}}}}
    },
    "then": {
      "properties": {
        "backendHost": {"minLength": 1},
        "service": {"properties": {"subnetId": {"const": ""}}},
        "temporaryUpload": {"properties": {"enabled": {"const": false}}}
      }
    },
    "else": {
      "properties": {
        "backendHost": {"const": ""},
        "service": {"properties": {"subnetId": {"pattern": "^subnet-[a-z0-9]+$"}}}
      }
    }
  }, {
    "if": {
      "properties": {"service": {"properties": {"mode": {"const": "apig-production"}}}}
    },
    "then": {
      "properties": {"service": {"properties": {"productionConfirmed": {"const": true}}}}
    },
    "else": {
      "properties": {"service": {"properties": {"productionConfirmed": {"const": false}}}}
    }
  }],
  "definitions": {
    "configKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuRequestMillis",
        "cpuLimitMillis",
        "memoryRequestMiB",
        "memoryLimitMiB"
      ],
      "properties": {
        "cpuRequestMillis": {
          "type": "integer",
          "minimum": 50,
          "maximum": 4000
        },
        "cpuLimitMillis": {
          "type": "integer",
          "minimum": 50,
          "maximum": 4000
        },
        "memoryRequestMiB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 8192
        },
        "memoryLimitMiB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 8192
        }
      }
    }
  }
}
