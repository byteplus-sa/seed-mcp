{
	admin off
	auto_https off
	grace_period {$MCP_PROXY_GRACE_PERIOD:630s}
	log {
		output discard
	}
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			idle 5m
		}
	}
}

https://:{$MCP_PROXY_PORT:8443} {
	tls {$MCP_TLS_CERT_FILE} {$MCP_TLS_KEY_FILE}
	respond "Not Found" 404
}

https://{$MCP_BACKEND_HOST}:{$MCP_PROXY_PORT:8443}, https://{$MCP_PUBLIC_HOST}:{$MCP_PROXY_PORT:8443} {
	tls {$MCP_TLS_CERT_FILE} {$MCP_TLS_KEY_FILE}

	route {
		@modelark header X-ModelArk-Api-Key *
		respond @modelark "Staging accepts credential-free synthetic traffic only." 403
		@speech header X-Seed-Speech-Api-Key *
		respond @speech "Staging accepts credential-free synthetic traffic only." 403
		@client header X-MCP-Client-Secret *
		respond @client "Staging accepts credential-free synthetic traffic only." 403
		@authorization header Authorization *
		respond @authorization "Staging accepts credential-free synthetic traffic only." 403

		@public path /mcp /health
		handle @public {
			request_body {
				max_size {$MCP_HTTP_MAX_BODY_BYTES:2097152}
			}
			reverse_proxy 127.0.0.1:{$MCP_PORT:3000} {
				header_up Host {$MCP_PUBLIC_HOST}
				header_up -Forwarded
				header_up -X-Seed-Staging-Probe
				header_up X-Forwarded-For {http.request.remote.host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {$MCP_PUBLIC_HOST}
				flush_interval -1
				transport http {
					dial_timeout 5s
					response_header_timeout {$MCP_PROXY_GRACE_PERIOD:630s}
				}
			}
		}
		handle {
			respond "Not Found" 404
		}
	}
}
