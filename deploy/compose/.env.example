# Hosted BYOK: specs/SPEC_HOSTED_BYOK.md.
# Keep .env private (0600). Never add customer provider keys or client secrets.
# Only the explicit operator settings in compose.yaml enter the container.
# One instance only. The byok-state volume must be fresh; no old-state migration.
MCP_PUBLIC_HOST=mcp.example.com
MCP_ALLOWED_ORIGINS=

# No server-issued MCP key or Authorization header.
# REQUIRED: 32 random bytes as 64 lowercase hex. Keep stable across restarts.
# Generate a private operator env file with:
# python scripts/byteplus_deploy/generate_identity_secret.py operator /private/operator.env
# Changing either identity setting changes all ownership scopes; no recovery bridge.
MCP_AUTH_MODE=byok
MCP_IDENTITY_HMAC_KEY=
MCP_IDENTITY_KEY_VERSION=1

# Callers use X-ModelArk-Api-Key, X-Seed-Speech-Api-Key or X-OmniHuman-Api-Key
# with their own X-MCP-Client-Secret. Discovery is anonymous.
BYTEPLUS_OMNIHUMAN_ENABLED=false

# Per-owner estimate cap; not a provider billing guarantee.
DAILY_BUDGET_USD=25
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=0
MCP_HTTP_MAX_IN_FLIGHT=64
MCP_HTTP_MAX_BODY_BYTES=2097152
PROVIDER_MAX_CONCURRENCY=5
PRINCIPAL_MAX_CONCURRENCY=3

# URL-only foreground HTTP. No Redis, jobs, artifacts or object storage.
STATE_BACKEND=sqlite
STATE_MAX_RECORDS=100000
STATE_PRUNE_MAX_AGE_DAYS=30

ARK_LOG_LEVEL=INFO
